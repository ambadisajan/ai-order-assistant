# Backend Environment Variables Example
# Copy this file to .env and fill in your actual credentials.

# LLM Provider Configuration (OpenAI or any OpenAI-compatible API like Groq, Ollama, Gemini OpenAI endpoint)
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# CORS Settings (comma-separated list of origins permitted to access this API)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Server Settings
HOST=0.0.0.0
PORT=8000

# Path to the orders CSV dataset (relative to backend/ directory or absolute path)
DATA_PATH=data/orders.csv
